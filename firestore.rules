rules_version = '2';
// Bro 2 Bro Golf Club: Firestore security rules.
// Editing this file does nothing on its own. Paste it into
// Firebase Console -> Firestore -> Rules and click Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // Admin is matched by account ID (UID), not email. Keep in sync with adminUids in config.js.
    function isAdmin() { return signedIn() && me() in ['luHWGpswl8MhxYuWJEHos7sqN8R2']; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // Signed in and not blocked by the admin. The admin can never be blocked.
    function active() { return signedIn() && (isAdmin() || !exists(/databases/$(database)/documents/blocked/$(me()))); }

    // Sign-in emails: { email, pw }. Each player saves their own (it must match their login),
    // and only the admin can read them, for sending password resets.
    match /emails/{uid} {
      allow read: if isAdmin() || (signedIn() && me() == uid);
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['email', 'pw'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.pw is bool;
      allow delete: if isAdmin();
    }

    // Blocked players: { at, by }. Only the admin can add or remove one.
    // A player can read their own entry so the app can tell them they're blocked.
    match /blocked/{uid} {
      allow read: if signedIn() && (me() == uid || isAdmin());
      allow create, update: if isAdmin() && uid != me()
        && request.resource.data.keys().hasOnly(['at', 'by']);
      allow delete: if isAdmin();
    }

    // Feedback: { by, name, kind, text, page, ua, scr, at, status, notes, closed }.
    // Anyone active can send one as themselves. Only the admin can read, add notes, clear or delete.
    match /feedback/{id} {
      function fbOk() {
        let d = request.resource.data;
        return d.keys().hasOnly(['by', 'name', 'kind', 'text', 'page', 'ua', 'scr', 'at', 'status', 'notes', 'closed'])
          && d.kind in ['bug', 'idea']
          && d.text is string && d.text.size() > 0 && d.text.size() <= 2000
          && d.name is string && d.name.size() <= 40
          && d.page is string && d.page.size() <= 80
          && d.ua is string && d.ua.size() <= 300
          && d.scr is string && d.scr.size() <= 20
          && d.at is int
          && d.status in ['open', 'prog', 'done'];
      }
      allow read, delete: if isAdmin();
      allow create: if active() && fbOk()
        && request.resource.data.by == me()
        && request.resource.data.status == 'open'
        && !('notes' in request.resource.data)
        && !('closed' in request.resource.data);
      allow update: if isAdmin() && fbOk()
        && !changed().hasAny(['by', 'at'])
        && (!('notes' in request.resource.data) || (request.resource.data.notes is map && request.resource.data.notes.size() <= 200))
        && (!('closed' in request.resource.data) || request.resource.data.closed is int);
    }

    // Player profiles: { name, joined, pic }. Everyone signed in can read; you can only write your own.
    // pic is a small square JPEG stored as text (about 10-20 KB), or '' when removed.
    match /players/{uid} {
      allow read: if active();
      allow create, update: if active() && (me() == uid || isAdmin())
        && request.resource.data.keys().hasOnly(['name', 'joined', 'pic'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && (!('pic' in request.resource.data)
            || request.resource.data.pic == ''
            || (request.resource.data.pic is string
                && request.resource.data.pic.size() <= 100000
                && request.resource.data.pic.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')));
      allow delete: if isAdmin();
    }

    // Range: { clubs: [up to 14 club ids], dist: { clubId: { avg, shots, at } } }.
    // Private for now: only you can read or change your own bag.
    match /bags/{uid} {
      allow read, delete: if active() && me() == uid;
      allow create, update: if active() && me() == uid
        && request.resource.data.keys().hasOnly(['clubs', 'dist'])
        && (!('clubs' in request.resource.data) || (request.resource.data.clubs is list && request.resource.data.clubs.size() <= 14))
        && (!('dist' in request.resource.data) || (request.resource.data.dist is map && request.resource.data.dist.size() <= 25));
    }

    // Rounds. The host and the players in a round can edit it. Anyone else
    // can only add themselves (joining). Nobody can change who the host is.
    match /rounds/{id} {
      function inRound() {
        return me() == resource.data.host
          || (me() in resource.data.get('players', {})
              && resource.data.players[me()] != null);
      }
      function joiningOnly() {
        return changed().hasOnly(['players'])
          && request.resource.data.players.diff(resource.data.get('players', {})).affectedKeys().hasOnly([me()])
          && request.resource.data.players[me()].uid == me();
      }
      allow read: if active();
      allow create: if active() && request.resource.data.host == me();
      allow update: if active()
        && request.resource.data.host == resource.data.host
        && (inRound() || joiningOnly() || isAdmin());
      allow delete: if active() && (resource.data.host == me() || isAdmin());
    }

    // Shared course details people add during rounds (pars, tee ratings, new courses).
    match /courseinfo/{id} {
      function shapeOk() {
        return request.resource.data.keys().hasOnly(['par', 'pn', 'tees', 'added'])
          && (!('par' in request.resource.data) || (request.resource.data.par is map && request.resource.data.par.size() <= 27))
          && (!('pn' in request.resource.data) || request.resource.data.pn is int)
          && (!('tees' in request.resource.data) || (request.resource.data.tees is map && request.resource.data.tees.size() <= 20));
      }
      allow read: if active();
      allow create: if active() && shapeOk();
      // A course someone added can't be renamed or removed by others later.
      allow update: if active() && shapeOk() && !changed().hasAny(['added']);
      allow delete: if isAdmin();
    }

    // Friend links. The document ID must be the two account IDs in sorted
    // order joined by "~", and only those two people can touch it.
    match /friends/{id} {
      function body() { return request.resource.data; }
      function idOk() { return body().a < body().b && id == body().a + '~' + body().b; }
      allow read: if active();
      // Sending a request: it must come from you and start as pending.
      allow create: if active() && idOk()
        && me() in [body().a, body().b]
        && body().from == me()
        && body().status == 'pending';
      // Accepting: only the person who did NOT send the request can accept it.
      allow update: if active() && idOk()
        && me() in [resource.data.a, resource.data.b]
        && body().a == resource.data.a && body().b == resource.data.b
        && body().from == resource.data.from
        && body().status in ['pending', 'accepted']
        && (body().status == 'pending' || resource.data.status == 'accepted' || resource.data.from != me());
      // Cancel, decline or unfriend: either person.
      allow delete: if active() && me() in [resource.data.a, resource.data.b];
    }
  }
}
